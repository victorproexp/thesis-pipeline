htmlcov/

# Jupyter
.ipynb_checkpoints/

# VS Code workspace-local settings
.vscode/

# Logs and temp files
*.log
*.tmp
*.temp

# Office/backup artifacts
~$*.docx
*.bak
*.swp
*.swo

# Build/distribution artifacts
build/
dist/
*.egg-info/

# Local secrets/environment files
.env
.env.*

# Node-related caches (if used by frontend experiments)
node_modules/
.npm/
